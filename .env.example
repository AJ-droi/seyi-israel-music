# Copy to .env.local for local development, and add the same values to your host's
# environment variables (Vercel/Netlify) for the live site.

# Required. Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Sender on a domain verified in Resend (resend.com/domains). Before the domain is verified,
# onboarding@resend.dev works, but Resend only delivers to your own Resend sign-up address.
CONTACT_FROM="Seyi Israel Music <website@YOUR-DOMAIN>"

# Inbox that receives messages (comma-separate several). Required until contact.form.to is set in content/site.ts
CONTACT_TO=
